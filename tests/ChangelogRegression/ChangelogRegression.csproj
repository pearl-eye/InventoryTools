<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ionide.KeepAChangelog" Version="0.2.0" />
    <Compile Include="../../InventoryTools/Services/ChangelogService.cs" Link="ChangelogService.cs" />
    <None Include="../../InventoryTools/CHANGELOG.md" Link="ReleaseCHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
